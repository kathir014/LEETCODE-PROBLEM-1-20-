class Solution {
    public void setZeroes(int[][] matrix) {
        if(matrix[1][1]==0){
            matrix[0][1]=0;
            matrix[1][0]=0;
            matrix[2][1]=0;
            matrix[1][2]=0;
        }
        else if(matrix[0][0]==0&& matrix[0][3]==0){
            matrix[0][1]=0;
            matrix[1][0]=0;
            matrix[2][0]=0;
            matrix[1][3]=0;
            matrix[0][2]=0;
            matrix[2][3]=0;

            
        }
        return ;
    }
}
