class Solution {
    public boolean isPalindrome(int x) {
        int a=x;
        int rev=0;

        while(x!=0){
            int c=x%10;
             rev=rev*10+c;
             x=x/10;
        }
        if((a==rev)&&(a>0)){
                return(true);
            }
        else {
            return(false);
        }
        
    }
}
